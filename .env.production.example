# 复制为 .env.production 后填写。不要把 .env.production 上传到公开仓库。

# 第一次只使用公网 IP 测试时填写服务器公网 IP，例如：203.0.113.10
# 绑定域名后可写成：sports.example.com,www.sports.example.com
DJANGO_ALLOWED_HOSTS=YOUR_SERVER_IP

# 使用不少于 50 个字符的随机值。可在服务器执行：
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# 同域部署无需 CORS；绑定域名后填写 HTTPS 地址，用英文逗号分隔。
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP

# HTTP 公网 IP 验证阶段保持 false/0；HTTPS 配置完成后按部署文档修改。
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# MySQL。三个密码/密钥必须改为互不相同的强随机值。
DB_NAME=sports_portal
DB_USER=sports_portal
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_ROOT_PASSWORD
DB_CONN_MAX_AGE=60

MESSAGE_SUBMISSION_RATE=5/hour
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# 仅数据库为空时导入确认后的初始内容，之后容器重启不会覆盖后台修改。
SEED_INITIAL_CONTENT=true
